# Twilio ConversationRelay Environment Configuration

# Required: Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# AWS credentials for deployment if not using default profile
# Set to your preferred profile name (not 'default')
AWS_PROFILE=devaccount
AWS_REGION=us-east-1

# Deployment configuration
STACK_NAME=twilio-conversation-relay
SERVICE_NAME=twilio-conversation-relay

# Optional: SSL/TLS Configuration (for production HTTPS)
# Get certificate ARN from AWS Certificate Manager
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012

# Optional: Custom domain name
# DOMAIN_NAME=api.yourdomain.com

# Idle configuration
IDLE_MAX_ATTEMPTS=3
IDLE_TIMEOUT=20

# Additional configuration
LANGUAGE=en-US
INITIAL_HINTS=
DTMF_MAX_DIGITS=10
DTMF_TIMEOUT=3
ERROR_MAX_ATTEMPTS=5

# Development mode (allows running without HTTPS for testing)
# Set to "development" to disable strict webhook validation
# # Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
FORCE_VALIDATION=false

# External URL (e.g. for ngrok)
# Set this to your ngrok URL for development webhook testing
# Example: EXTERNAL_URL=https://abc123.ngrok.dev
# EXTERNAL_URL=
